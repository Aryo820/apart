APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Midtrans payment gateway (see https://docs.midtrans.com)
# Server & client keys from Midtrans dashboard (Sandbox/Production).
# In production: APP_ENV=production, APP_DEBUG=false, MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Seed credentials used by DatabaseSeeder (dev only).
# Leave ADMIN_PASSWORD empty to get a random password printed on seed.
# In production always set explicit values — never use a committed default.
ADMIN_EMAIL=admin@apart.com
ADMIN_PASSWORD=
USER_EMAIL=user@apart.com
USER_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# public, bukan local: foto unit yang diunggah admin harus bisa dilayani lewat
# HTTP (public/storage -> storage/app/public, dibuat `php artisan storage:link`).
# Disk 'local' menyimpannya di storage/app/private yang tidak pernah web-served,
# sehingga setiap gambar 404 walaupun URL-nya terbentuk benar.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identitas bisnis & jalur bantuan yang tampil di footer, halaman legal, dan
# halaman reservasi (config/support.php). Ganti dengan data resmi sebelum go-live.
BUSINESS_NAME="Santhosa"
SUPPORT_EMAIL=support@santhosa.test
SUPPORT_PHONE="+62 21 5000 1234"
SUPPORT_HOURS="Setiap hari, 08.00–21.00 WIB"

# Batas waktu pembayaran booking, dihitung dari waktu booking dibuat.
# Setelah lewat, booking otomatis EXPIRED dan tanggalnya bebas kembali.
# Nilai ini juga dikirim ke Midtrans sebagai masa berlaku transaksi.
BOOKING_PAYMENT_EXPIRY_MINUTES=1440
